# MoveInSync Commute Policy Assistant - Environment Configuration

# Application Environment (development | production | test)
APP_ENV=development

# LLM Provider selection: 'groq', 'gemini', or 'fake'
LLM_PROVIDER=groq

# Groq API Configuration (Ultra-low latency LPU engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration (Alternative cloud provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# SLA & Latency Timeouts (seconds)
LLM_TIMEOUT_SECONDS=4.0

# Security - JWT secret for tenant session verification
JWT_SECRET=moveinsync-campus-case-study-b-secure-jwt-key-2026

# Retrieval Settings
DEFAULT_RETRIEVAL_MODE=hybrid
CHROMA_PERSIST_DIR=data/chroma_db
